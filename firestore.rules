rules_version = '2';

// Nibble Social security rules. Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // `owner` lists the caller as a friend
    function isFriendOf(owner) { return exists(/databases/$(database)/documents/users/$(owner)/friends/$(me())); }
    // admin = a doc exists at admins/{your uid} (add it by hand in the Firebase console)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    // suspended by an admin = a doc exists at banned/{your uid}
    function isBanned() { return signedIn() && exists(/databases/$(database)/documents/banned/$(me())); }
    function validName(n) { return n is string && n.matches('^[a-z0-9_]{3,20}$'); }
    function shortText(t, max) { return t is string && t.size() <= max; }
    function incoming() { return request.resource.data; }
    // wardrobe look: { sp: species, of: outfit, oc: outfit colour, sk: skill }
    function validStyle(st) {
      return st is map && st.keys().hasOnly(['sp', 'of', 'oc', 'sk'])
        && shortText(st.get('sp', ''), 12) && shortText(st.get('of', ''), 12) && shortText(st.get('oc', ''), 7) && shortText(st.get('sk', ''), 12);
    }

    // admins: one doc per admin uid. Created only in the Firebase console; readable only by that admin.
    match /admins/{uid} {
      allow get: if signedIn() && uid == me();
      allow list, write: if false;
    }

    // suspended accounts. The person can see that they're suspended; only admins manage the list.
    match /banned/{uid} {
      allow get: if signedIn() && (uid == me() || isAdmin());
      allow list, write: if isAdmin();
    }

    // the live site-wide announcement banner, set by an admin
    match /broadcast/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && incoming().keys().hasOnly(['title', 'text', 'level', 'link', 'expiresAt', 'at', 'by', 'id'])
        && shortText(incoming().get('text', ''), 200)
        && shortText(incoming().get('title', ''), 60)
        && shortText(incoming().get('level', 'info'), 10)
        && shortText(incoming().get('link', ''), 200);
    }

    // announcement history (admin only)
    match /broadcasts/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    // site config: minimum desktop version, pinned notice, game switches, Saver mode and daily
    // limits (config/app.limits: matches, solo, music). Everyone reads, admins write.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && incoming().keys().hasOnly(['minVersion', 'updateMsg', 'notice', 'noticeLevel', 'updatedAt', 'by', 'games', 'gamesOff', 'shop', 'saver', 'limits'])
        && (!('saver' in incoming()) || incoming().saver is bool)
        && (!('limits' in incoming()) || (incoming().limits is map && incoming().limits.keys().hasOnly(['matches', 'solo', 'music'])))
        && (!('gamesOff' in incoming()) || (incoming().gamesOff is list && incoming().gamesOff.size() <= 30))
        && shortText(incoming().get('minVersion', ''), 12)
        && shortText(incoming().get('updateMsg', ''), 160)
        && shortText(incoming().get('notice', ''), 200)
        && shortText(incoming().get('noticeLevel', 'info'), 10);
    }

    // one doc per claimed username → { uid }
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && !isBanned() && validName(name)
        && incoming().keys().hasOnly(['uid']) && incoming().uid == me();
      allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
      allow update: if false;
    }

    // public profile: username, pet, character, look. No emails are stored here.
    match /users/{uid} {
      allow read: if signedIn();
      allow list: if isAdmin();
      allow create, update: if signedIn() && uid == me() && !isBanned()
        && incoming().keys().hasOnly(['username', 'petName', 'skin', 'acc', 'tint', 'makeup', 'style', 'createdAt', 'updatedAt'])
        && validName(incoming().username)
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == me()
        && shortText(incoming().get('petName', ''), 20)
        && shortText(incoming().get('skin', ''), 20)
        && (!('acc' in incoming()) || incoming().acc is list)
        && shortText(incoming().get('tint', ''), 7)
        && shortText(incoming().get('makeup', ''), 12)
        && (!('style' in incoming()) || validStyle(incoming().style));
      // admins may only reset someone's look — nothing else on their profile
      allow update: if isAdmin()
        && incoming().diff(resource.data).affectedKeys().hasOnly(['acc', 'tint', 'makeup', 'style', 'updatedAt']);
      allow delete: if isAdmin();

      // friendships are written on both sides when a request is accepted
      match /friends/{fid} {
        allow read: if signedIn() && uid == me();
        allow create: if signedIn() && !isBanned()
          && incoming().keys().hasOnly(['username', 'since'])
          && shortText(incoming().username, 20)
          && (
            // accepting: add the requester to my list…
            (uid == me() && exists(/databases/$(database)/documents/requests/$(fid + '_' + me())))
            // …and add myself to the requester's list
            || (fid == me() && exists(/databases/$(database)/documents/requests/$(uid + '_' + me())))
          );
        allow delete: if signedIn() && (uid == me() || fid == me());
        allow update: if false;
      }

      // private docs: "about" (nickname, role, interests, current focus) and "deadlines"
      // (your reminder list). Only the owner can read or write; admins can only delete them.
      match /private/{doc} {
        allow read: if signedIn() && uid == me();
        allow write: if signedIn() && uid == me() && !isBanned() && (
          (doc == 'about'
            && incoming().keys().hasOnly(['nick', 'role', 'interests', 'focus', 'updatedAt'])
            && shortText(incoming().get('nick', ''), 20)
            && shortText(incoming().get('role', ''), 20)
            && shortText(incoming().get('focus', ''), 40)
            && (!('interests' in incoming()) || (incoming().interests is list && incoming().interests.size() <= 6)))
          || (doc == 'deadlines'
            && incoming().keys().hasOnly(['items', 'updatedAt'])
            && incoming().items is list && incoming().items.size() <= 40)
        );
        allow delete: if isAdmin();
      }
    }

    // friend requests: id is "{from}_{to}"
    match /requests/{rid} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && !isBanned()
        && incoming().keys().hasOnly(['from', 'to', 'fromName', 'toName', 'at'])
        && incoming().from == me()
        && incoming().to is string && incoming().to != me()
        && rid == me() + '_' + incoming().to
        && shortText(incoming().fromName, 20) && shortText(incoming().toName, 20)
        && exists(/databases/$(database)/documents/users/$(incoming().to))
        && !exists(/databases/$(database)/documents/users/$(me())/friends/$(incoming().to));
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow update: if false;
    }

    // online status, "thinking…", last short message, look, and which app/version.
    // Only you, your friends and admins can read it.
    match /presence/{uid} {
      allow read: if signedIn() && (uid == me() || isFriendOf(uid) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && uid == me() && !isBanned()
        && incoming().keys().hasOnly(['online', 'lastSeen', 'username', 'petName', 'skin', 'acc', 'tint', 'makeup', 'status', 'dnd', 'typing', 'typingAt', 'typingTo', 'say', 'client', 'ver', 'np', 'room', 'wseq', 'style'])
        && (!('np' in incoming()) || incoming().np == null || (incoming().np is map && shortText(incoming().np.get('title', ''), 80) && shortText(incoming().np.get('artist', ''), 60)))
        && shortText(incoming().get('room', ''), 40)
        && shortText(incoming().get('status', ''), 40)
        && shortText(incoming().get('petName', ''), 20)
        && shortText(incoming().get('client', ''), 10)
        && shortText(incoming().get('ver', ''), 12)
        && (!('acc' in incoming()) || incoming().acc is list)
        && (!('style' in incoming()) || validStyle(incoming().style))
        && (!('say' in incoming()) || (incoming().say is map && shortText(incoming().say.text, 80) && shortText(incoming().say.id, 40)));
      allow delete: if (signedIn() && uid == me()) || isAdmin();
    }

    // Listen Together rooms: id = the host's uid. Only the host and the friends they invited can
    // see a room. Anyone in it can play / pause / skip / queue; only the host can invite or end it.
    function roomShape() {
      return incoming().keys().hasOnly(['host', 'hostName', 'invited', 'names', 'inv', 'here', 'track', 'playing', 'pos', 'startedAt', 'queue', 'radio', 'repeat', 'shuffle', 'history', 'updatedAt'])
        && incoming().get('inv', {}) is map
        && incoming().get('repeat', 'all') in ['off', 'all', 'one']
        && incoming().get('shuffle', false) is bool
        && incoming().get('history', []) is list && incoming().get('history', []).size() <= 60
        && incoming().invited is list && incoming().invited.size() <= 10
        && incoming().get('queue', []) is list && incoming().get('queue', []).size() <= 60
        && shortText(incoming().get('hostName', ''), 20)
        && incoming().get('names', {}) is map && incoming().get('here', {}) is map;
    }
    match /rooms/{rid} {
      allow get: if signedIn() && (resource == null || resource.data.host == me() || me() in resource.data.invited);
      // "rooms I'm invited to" (query: invited array-contains me)
      allow list: if signedIn() && me() in resource.data.invited;
      allow create: if signedIn() && !isBanned() && rid == me() && incoming().host == me() && roomShape();
      allow update: if signedIn() && !isBanned() && roomShape() && (
        (resource.data.host == me() && incoming().host == me())
        || (me() in resource.data.invited
          && incoming().host == resource.data.host
          && incoming().invited == resource.data.invited
          && incoming().get('names', {}) == resource.data.get('names', {})
          && incoming().get('inv', {}) == resource.data.get('inv', {})));
      allow delete: if signedIn() && resource.data.host == me();
    }

    // ---------- points (⭐) ----------
    // wallets/{uid}: points, owned shop items, daily bonus, best game scores. Anyone signed in can
    // read (friends' leaderboards); only you can write, and only in these ways:
    //   earn: +1…60 points (≤160 when claiming the daily bonus), ≥ 5 s after the last write, ≤ 1500 a day
    //   spend: owned items grow and points drop by at least 25 per new item
    //   gift out / gift in: matched against a gifts/{id} doc written in the same batch
    //   best: only personal best scores change
    //   total: points earned all-time (the leaderboard); only earning raises it, set once for older wallets
    function today() { return math.floor(request.time.toMillis() / 86400000.0); }
    function wpath(uid) { return /databases/$(database)/documents/wallets/$(uid); }
    function gpath(gid) { return /databases/$(database)/documents/gifts/$(gid); }
    function walletShape() {
      return incoming().keys().hasOnly(['points', 'owned', 'day', 'earned', 'streak', 'daily', 'gin', 'gout', 'best', 'total', 'at'])
        && incoming().get('total', 0) is int && incoming().get('total', 0) >= 0
        && incoming().points is int && incoming().points >= 0
        && incoming().owned is list && incoming().owned.size() <= 200
        && incoming().day is int && incoming().earned is int && incoming().streak is int && incoming().daily is int
        && incoming().gin is string && incoming().gout is string
        && incoming().best is map && incoming().best.size() <= 20
        && incoming().at == request.time;
    }
    function unchanged(keys) { return !incoming().diff(resource.data).affectedKeys().hasAny(keys); }
    function sameTotal() { return incoming().get('total', 0) == resource.data.get('total', 0); }
    function earnOk() {
      let d = incoming().points - resource.data.points;
      let claimDaily = incoming().daily != resource.data.daily;
      return d > 0
        && unchanged(['owned', 'gin', 'gout'])
        && incoming().get('total', 0) == resource.data.get('total', 0) + d
        && request.time > resource.data.at + duration.value(5, 's')
        && incoming().day == today()
        && incoming().earned == (resource.data.day == today() ? resource.data.earned : 0) + d
        && incoming().earned <= 1500
        && (claimDaily
          ? (incoming().daily == today() && resource.data.daily != today() && d <= 160
             && incoming().streak == (resource.data.daily == today() - 1 ? resource.data.streak + 1 : 1))
          : (d <= 60 && unchanged(['streak'])));
    }
    function spendOk() {
      let n = incoming().owned.size() - resource.data.owned.size();
      return n >= 1 && incoming().owned.hasAll(resource.data.owned)
        && incoming().points <= resource.data.points - 25 * n
        && unchanged(['day', 'earned', 'streak', 'daily', 'gin', 'gout']) && sameTotal();
    }
    function giftOutOk() {
      return incoming().gout != resource.data.gout
        && !exists(gpath(incoming().gout))
        && existsAfter(gpath(incoming().gout))
        && getAfter(gpath(incoming().gout)).data.from == me()
        && incoming().points == resource.data.points - getAfter(gpath(incoming().gout)).data.amount
        && unchanged(['owned', 'day', 'earned', 'streak', 'daily', 'gin']) && sameTotal();
    }
    function giftInOk() {
      return incoming().gin != resource.data.gin
        && get(gpath(incoming().gin)).data.to == me()
        && get(gpath(incoming().gin)).data.claimed == false
        && getAfter(gpath(incoming().gin)).data.claimed == true
        && incoming().points == resource.data.points + get(gpath(incoming().gin)).data.amount
        && unchanged(['owned', 'day', 'earned', 'streak', 'daily', 'gout']) && sameTotal();
    }
    function bestOnly() { return incoming().diff(resource.data).affectedKeys().hasOnly(['best', 'total', 'at']) && sameTotal(); }
    // wallets made before the leaderboard: their total starts at the current balance, once
    function initTotal() {
      return !('total' in resource.data) && incoming().total == resource.data.points
        && incoming().diff(resource.data).affectedKeys().hasOnly(['total', 'at']);
    }
    match /wallets/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == me() && !isBanned() && walletShape()
        && incoming().points == 100 && incoming().owned.size() == 0 && incoming().earned == 0
        && incoming().streak == 0 && incoming().daily == 0 && incoming().gin == '' && incoming().gout == ''
        && incoming().get('total', 0) == 0;
      allow update: if signedIn() && uid == me() && !isBanned() && walletShape()
        && (earnOk() || spendOk() || giftOutOk() || giftInOk() || bestOnly() || initTotal());
      // admins can set points, grant items or reset a wallet
      allow update: if isAdmin() && walletShape();
      allow delete: if isAdmin();
    }
    // a gift of points between friends: the sender's wallet drops by `amount` in the same batch,
    // and the receiver adds it to theirs when they mark it claimed.
    match /gifts/{gid} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && !isBanned()
        && incoming().keys().hasOnly(['from', 'fromName', 'to', 'amount', 'note', 'claimed', 'at'])
        && incoming().from == me() && incoming().to is string && incoming().to != me()
        && isFriendOf(incoming().to)
        && incoming().amount is int && incoming().amount >= 1 && incoming().amount <= 500
        && incoming().claimed == false
        && shortText(incoming().get('note', ''), 60) && shortText(incoming().get('fromName', ''), 20)
        && getAfter(wpath(me())).data.gout == gid;
      allow update: if signedIn() && resource.data.to == me() && resource.data.claimed == false
        && incoming().diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && incoming().claimed == true
        && getAfter(wpath(me())).data.gin == gid;
      allow delete: if signedIn() && resource.data.to == me() && resource.data.claimed == true;
    }

    // live friend games (tic-tac-toe, connect four). Only the two players can see or touch a match;
    // you can only change the board on your own turn.
    function matchShape() {
      return incoming().keys().hasOnly(['game', 'players', 'names', 'board', 'turn', 'status', 'winner', 'moves', 'last', 'at'])
        && incoming().game in ['ttt', 'c4']
        && incoming().players is list && incoming().players.size() == 2
        && incoming().names is map
        && incoming().board is string && incoming().board.size() <= 64
        && incoming().status in ['invite', 'live', 'done']
        && shortText(incoming().get('turn', ''), 40) && shortText(incoming().get('winner', ''), 40);
    }
    match /matches/{mid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.players || isAdmin());
      allow create: if signedIn() && !isBanned() && matchShape()
        && incoming().players[0] == me() && incoming().players[1] != me()
        && isFriendOf(incoming().players[1]) && incoming().status == 'invite';
      allow update: if signedIn() && !isBanned() && me() in resource.data.players && matchShape()
        && incoming().players == resource.data.players && incoming().game == resource.data.game
        && (resource.data.turn == me() || incoming().board == resource.data.board);
      allow delete: if signedIn() && (me() in resource.data.players || isAdmin());
    }

    // "people on your network": lan/{netId}/members/{uid}. netId is a secret one-way hash of the
    // public IP from /api/netid, so you can only list a network you're on. Only you write your entry.
    match /lan/{net}/members/{uid} {
      allow read: if signedIn() && net.size() >= 8 && net.size() <= 40;
      allow create, update: if signedIn() && uid == me() && !isBanned()
        && net.size() >= 8 && net.size() <= 40
        && incoming().keys().hasOnly(['username', 'petName', 'skin', 'style', 'at'])
        && validName(incoming().username)
        && shortText(incoming().get('petName', ''), 20) && shortText(incoming().get('skin', ''), 20)
        && (!('style' in incoming()) || validStyle(incoming().style))
        && incoming().at == request.time;
      allow delete: if signedIn() && uid == me();
    }

    // direct pokes, waves, cuddles and whispers. Only friends can send; only you can read.
    match /inbox/{uid}/items/{id} {
      allow read, delete: if signedIn() && uid == me();
      allow create: if signedIn() && !isBanned() && isFriendOf(uid)
        && incoming().keys().hasOnly(['from', 'fromName', 'kind', 'text', 'at'])
        && incoming().from == me()
        && incoming().kind is string && incoming().kind.matches('^[a-z]{2,12}$')
        && shortText(incoming().get('text', ''), 80)
        && incoming().at == request.time;
      allow update: if false;
    }
  }
}
