rules_version = '2';

// Nibble Social security rules. Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // a chat reply quotes the message it answers: re = { n: who wrote it, t: short snippet }
    function okReply(d) {
      return !('re' in d) || (d.re is map && d.re.keys().hasOnly(['n', 't'])
        && d.re.n is string && d.re.n.size() <= 30 && d.re.t is string && d.re.t.size() >= 1 && d.re.t.size() <= 80);
    }
    // `owner` lists the caller as a friend
    function isFriendOf(owner) { return exists(/databases/$(database)/documents/users/$(owner)/friends/$(me())); }
    // admin = a doc exists at admins/{your uid} (add it by hand in the Firebase console)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    // suspended by an admin = a doc exists at banned/{your uid}
    function isBanned() { return signedIn() && exists(/databases/$(database)/documents/banned/$(me())); }
    function validName(n) { return n is string && n.matches('^[a-z0-9_]{3,20}$'); }
    function shortText(t, max) { return t is string && t.size() <= max; }
    function incoming() { return request.resource.data; }
    // Nibble Premium: premium/{uid} is written only by the server (Stripe webhook) and admins
    function isPremium(uid) {
      let p = /databases/$(database)/documents/premium/$(uid);
      return exists(p) && get(p).data.active == true && get(p).data.until > request.time.toMillis();
    }
    // wardrobe look: { sp: species, of: outfit, oc: outfit colour, sk: skill }
    function validStyle(st) {
      return st is map && st.keys().hasOnly(['sp', 'of', 'oc', 'sk'])
        && shortText(st.get('sp', ''), 12) && shortText(st.get('of', ''), 12) && shortText(st.get('oc', ''), 7) && shortText(st.get('sk', ''), 12);
    }

    // admins: one doc per admin uid. Created only in the Firebase console; readable only by that admin.
    match /admins/{uid} {
      allow get: if signedIn() && uid == me();
      allow list, write: if false;
    }

    // suspended accounts. The person can see that they're suspended; only admins manage the list.
    match /banned/{uid} {
      allow get: if signedIn() && (uid == me() || isAdmin());
      allow list, write: if isAdmin();
    }

    // the live site-wide announcement banner, set by an admin
    match /broadcast/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && incoming().keys().hasOnly(['title', 'text', 'level', 'link', 'expiresAt', 'at', 'by', 'id'])
        && shortText(incoming().get('text', ''), 200)
        && shortText(incoming().get('title', ''), 60)
        && shortText(incoming().get('level', 'info'), 10)
        && shortText(incoming().get('link', ''), 200);
    }

    // announcement history (admin only)
    match /broadcasts/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    // site config: minimum desktop version, pinned notice, game switches, Saver mode and daily
    // limits (config/app.limits: matches, solo, music). Everyone reads, admins write.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && incoming().keys().hasOnly(['minVersion', 'updateMsg', 'notice', 'noticeLevel', 'updatedAt', 'by', 'games', 'gamesOff', 'shop', 'saver', 'limits', 'tea', 'teaWords'])
        && (!('tea' in incoming()) || (incoming().tea is map && incoming().tea.keys().hasOnly(['on', 'everyone', 'anon', 'anonAll', 'ios'])))
        && (!('teaWords' in incoming()) || (incoming().teaWords is list && incoming().teaWords.size() <= 100))
        && (!('saver' in incoming()) || incoming().saver is bool)
        && (!('limits' in incoming()) || (incoming().limits is map && incoming().limits.keys().hasOnly(['matches', 'solo', 'music'])))
        && (!('gamesOff' in incoming()) || (incoming().gamesOff is list && incoming().gamesOff.size() <= 30))
        && shortText(incoming().get('minVersion', ''), 12)
        && shortText(incoming().get('updateMsg', ''), 160)
        && shortText(incoming().get('notice', ''), 200)
        && shortText(incoming().get('noticeLevel', 'info'), 10);
    }

    // ---------- Nibble Premium ----------
    // the public plan (price, features, on/off). Anyone can read it (the website shows the price);
    // admins edit it. Packages (with their Stripe price ids) are written by the server when an admin saves one.
    match /config/premium {
      allow read: if true;
      allow write: if isAdmin()
        && incoming().keys().hasOnly(['enabled', 'name', 'amount', 'currency', 'interval', 'priceId', 'productId', 'features', 'packages', 'promoCodes', 'defaultPackage', 'updatedAt', 'by'])
        && (!('packages' in incoming()) || (incoming().packages is list && incoming().packages.size() <= 6))
        && incoming().get('promoCodes', true) is bool
        && shortText(incoming().get('defaultPackage', ''), 24)
        && incoming().get('enabled', false) is bool
        && shortText(incoming().get('name', ''), 40)
        && shortText(incoming().get('currency', 'usd'), 3)
        && incoming().get('interval', 'year') in ['year', 'month']
        && (!('amount' in incoming()) || (incoming().amount is int && incoming().amount >= 50))
        && (!('features' in incoming()) || (incoming().features is list && incoming().features.size() <= 12));
    }
    // who has Premium: friends see the badge; only the server and admins (through the server) write
    match /premium/{uid} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if false;
    }
    // server-only data (a health-check doc and Stripe customer ids): never readable from a browser
    match /billing/{doc} { allow read, write: if false; }
    match /billingCustomers/{uid} { allow read, write: if false; }
    // Stripe webhook events we've handled (dedupe + audit) and disputes / fraud warnings / refunds per account.
    // Written and read only by the server (service account); admins see them through /api/admin/premium.
    match /billingEvents/{id} { allow read, write: if false; }
    match /billingFlags/{uid} { allow read, write: if false; }
    // Admin → Stripe audit log: every refund / cancel / dispute answer / block, who did it and why (server only)
    match /billingAudit/{id} { allow read, write: if false; }

    // ---------- reviews ----------
    // One review per account (id = your uid). You write rating + text; every change goes back to
    // "pending" until an admin approves it. Anyone (even signed out) can read approved, public ones;
    // admins can only change status / featured / reply, never your words or stars.
    match /reviews/{uid} {
      allow get: if (resource.data.status == 'approved' && resource.data.show == true) || (signedIn() && (uid == me() || isAdmin()));
      allow list: if (resource.data.status == 'approved' && resource.data.show == true) || isAdmin();
      allow create, update: if signedIn() && uid == me() && !isBanned()
        && incoming().keys().hasOnly(['uid', 'username', 'skin', 'rating', 'text', 'show', 'client', 'status', 'featured', 'reply', 'at', 'updatedAt'])
        && incoming().uid == me()
        && incoming().username == get(/databases/$(database)/documents/users/$(me())).data.username
        && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
        && incoming().text is string && incoming().text.size() >= 10 && incoming().text.size() <= 400
        && incoming().show is bool && shortText(incoming().get('skin', ''), 20) && shortText(incoming().get('client', ''), 16)
        && incoming().status == 'pending' && incoming().get('featured', false) == false
        && incoming().get('reply', '') == (resource == null ? '' : resource.data.get('reply', ''))
        && incoming().updatedAt == request.time
        && (resource == null ? incoming().at == request.time : incoming().at == resource.data.at);
      allow update: if isAdmin()
        && incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'featured', 'reply'])
        && incoming().status in ['pending', 'approved', 'hidden']
        && incoming().get('featured', false) is bool
        && shortText(incoming().get('reply', ''), 300);
      allow delete: if signedIn() && (uid == me() || isAdmin());
    }

    // SEO settings (Admin → SEO): titles, descriptions, share images, search verification codes.
    // Public (the website reads it to build every page's tags); only admins write.
    match /seo/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'site'
        && incoming().keys().hasOnly(['siteName', 'titleTemplate', 'keywords', 'twitter', 'googleVerify', 'bingVerify', 'noindex', 'pages', 'updatedAt', 'by'])
        && shortText(incoming().get('siteName', ''), 40) && shortText(incoming().get('titleTemplate', ''), 60)
        && shortText(incoming().get('keywords', ''), 600) && shortText(incoming().get('twitter', ''), 30)
        && shortText(incoming().get('googleVerify', ''), 100) && shortText(incoming().get('bingVerify', ''), 100)
        && incoming().get('noindex', false) is bool
        && incoming().get('pages', {}) is map && incoming().get('pages', {}).size() <= 16;
    }

    // one doc per claimed username → { uid }
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && !isBanned() && validName(name)
        && incoming().keys().hasOnly(['uid']) && incoming().uid == me();
      allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
      allow update: if false;
    }

    // public profile: username, pet, character, look. No emails are stored here.
    match /users/{uid} {
      allow read: if signedIn();
      allow list: if isAdmin();
      allow create, update: if signedIn() && uid == me() && !isBanned()
        && incoming().keys().hasOnly(['username', 'petName', 'skin', 'acc', 'tint', 'makeup', 'style', 'createdAt', 'updatedAt'])
        && validName(incoming().username)
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == me()
        && shortText(incoming().get('petName', ''), 20)
        && shortText(incoming().get('skin', ''), 20)
        && (!('acc' in incoming()) || (incoming().acc is list && incoming().acc.size() <= 12))
        && shortText(incoming().get('tint', ''), 7)
        && shortText(incoming().get('makeup', ''), 12)
        && (!('style' in incoming()) || validStyle(incoming().style));
      // admins may only reset someone's look — nothing else on their profile
      allow update: if isAdmin()
        && incoming().diff(resource.data).affectedKeys().hasOnly(['acc', 'tint', 'makeup', 'style', 'updatedAt']);
      allow delete: if isAdmin();

      // friendships are written on both sides when a request is accepted
      match /friends/{fid} {
        allow read: if signedIn() && uid == me();
        allow create: if signedIn() && !isBanned()
          && incoming().keys().hasOnly(['username', 'since'])
          && shortText(incoming().username, 20)
          // the name saved for a friend (fid) is fid's real username, on either side (no one can pose as someone else)
          && incoming().username == get(/databases/$(database)/documents/users/$(fid)).data.username
          && (
            // accepting: add the requester to my list…
            (uid == me() && exists(/databases/$(database)/documents/requests/$(fid + '_' + me())))
            // …and add myself to the requester's list
            || (fid == me() && exists(/databases/$(database)/documents/requests/$(uid + '_' + me())))
          );
        allow delete: if signedIn() && (uid == me() || fid == me());
        allow update: if false;
      }

      // private docs: "about" (nickname, role, interests, current focus) and "deadlines"
      // (your reminder list). Only the owner can read or write; admins can only delete them.
      match /private/{doc} {
        allow read: if signedIn() && uid == me();
        allow write: if signedIn() && uid == me() && !isBanned() && (
          (doc == 'about'
            && incoming().keys().hasOnly(['nick', 'role', 'interests', 'focus', 'updatedAt'])
            && shortText(incoming().get('nick', ''), 20)
            && shortText(incoming().get('role', ''), 20)
            && shortText(incoming().get('focus', ''), 40)
            && (!('interests' in incoming()) || (incoming().interests is list && incoming().interests.size() <= 6)))
          || (doc == 'deadlines'
            && incoming().keys().hasOnly(['items', 'updatedAt'])
            && incoming().items is list && incoming().items.size() <= 40)
        );
        allow delete: if isAdmin();
      }
    }

    // ---------- groups ----------
    // groups/{gid}: a few friends together (≤ 20). You can only invite your own friends, one at a time.
    // Invited people accept or decline; anyone can leave; the owner can rename, remove people or delete it.
    // chatAt/chatBy change with every group chat message; teaAt is set by the server (Tea Room).
    function myName() { return get(/databases/$(database)/documents/users/$(me())).data.username; }
    function changed() { return incoming().diff(resource.data).affectedKeys(); }
    function groupBase() {
      return incoming().keys().hasOnly(['owner', 'name', 'emoji', 'members', 'invited', 'names', 'at', 'updatedAt', 'chatAt', 'chatBy', 'chatTo', 'teaAt'])
        && (!('chatTo' in incoming()) || (incoming().chatTo is list && incoming().chatTo.size() <= 20))
        && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 30
        && shortText(incoming().emoji, 8)
        && incoming().members is list && incoming().members.size() >= 1 && incoming().members.size() <= 20
        && incoming().invited is list && incoming().invited.size() <= 20
        && incoming().names is map && incoming().names.size() <= 60
        && incoming().owner in incoming().members
        && incoming().updatedAt == request.time;
    }
    // inviting adds exactly one person, at the end of the list: one of my friends, not already in
    function inviteOk() {
      // size first, so the new entry is only read when there is one
      return incoming().invited.size() == resource.data.invited.size() + 1
        && newInvite(incoming().invited[resource.data.invited.size()]);
    }
    function newInvite(x) {
      return incoming().invited == resource.data.invited.concat([x])
        && !(x in resource.data.members)
        && exists(/databases/$(database)/documents/users/$(me())/friends/$(x))
        && incoming().names.diff(resource.data.names).affectedKeys().hasOnly([x])
        && incoming().names[x] == get(/databases/$(database)/documents/users/$(x)).data.username
        && incoming().members.size() + incoming().invited.size() <= 20;
    }
    match /groups/{gid} {
      allow get: if signedIn() && (resource == null || me() in resource.data.members || me() in resource.data.invited || isAdmin());
      allow list: if signedIn() && (me() in resource.data.members || me() in resource.data.invited);
      allow create: if signedIn() && !isBanned() && groupBase()
        && incoming().owner == me() && incoming().members == [me()] && incoming().invited.size() == 0
        && incoming().names.keys().hasOnly([me()]) && incoming().names[me()] == myName()
        && incoming().at == request.time
        && !('chatAt' in incoming()) && !('teaAt' in incoming());
      allow update: if signedIn() && !isBanned() && groupBase()
        && incoming().owner == resource.data.owner && incoming().at == resource.data.at && (
          // a member invites one of their friends
          (me() in resource.data.members && changed().hasOnly(['invited', 'names', 'updatedAt']) && inviteOk())
          // accept my invite
          || (me() in resource.data.invited && !(me() in resource.data.members)
            && changed().hasOnly(['members', 'invited', 'names', 'updatedAt'])
            && incoming().members == resource.data.members.concat([me()])
            && incoming().invited == resource.data.invited.removeAll([me()])
            && incoming().names.diff(resource.data.names).affectedKeys().hasOnly([me()])
            && incoming().names[me()] == myName())
          // decline my invite
          || (me() in resource.data.invited && changed().hasOnly(['invited', 'updatedAt'])
            && incoming().invited == resource.data.invited.removeAll([me()]))
          // leave (the owner deletes the group instead)
          || (me() in resource.data.members && me() != resource.data.owner && changed().hasOnly(['members', 'updatedAt'])
            && incoming().members == resource.data.members.removeAll([me()]))
          // a new group chat message (the badge for everyone else)
          // (chatTo = the members that message @mentions)
          || (me() in resource.data.members && changed().hasOnly(['chatAt', 'chatBy', 'chatTo', 'updatedAt'])
            && incoming().chatAt == request.time && incoming().chatBy == myName())
          // owner: rename, take people out, cancel invites (lists only shrink)
          || (me() == resource.data.owner && changed().hasOnly(['name', 'emoji', 'members', 'invited', 'updatedAt'])
            && resource.data.members.hasAll(incoming().members) && resource.data.invited.hasAll(incoming().invited))
        );
      allow delete: if signedIn() && (resource.data.owner == me() || isAdmin());

      // group chat: members only, text only, gone after 24 hours (exp is checked by the app; any member
      // may delete expired messages, the owner may delete any)
      match /msgs/{mid} {
        function grp() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
        allow read: if signedIn() && me() in grp().members;
        allow create: if signedIn() && !isBanned() && me() in grp().members
          && incoming().keys().hasOnly(['from', 'fromName', 'text', 'at', 'exp', 're', 'to'])
          && okReply(incoming())
          && (!('to' in incoming()) || (incoming().to is list && incoming().to.size() <= 20))
          && incoming().from == me() && incoming().fromName == myName()
          && incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 200
          && incoming().at == request.time
          && incoming().exp is int && incoming().exp > request.time.toMillis() && incoming().exp <= request.time.toMillis() + 90000000;
        allow delete: if signedIn() && (resource.data.from == me() || grp().owner == me()
          || (me() in grp().members && resource.data.exp < request.time.toMillis()));
        // reactions: each member can only set (or clear) their own one
        allow update: if signedIn() && !isBanned() && me() in grp().members
          && incoming().diff(resource.data).affectedKeys().hasOnly(['rx'])
          && incoming().rx is map && incoming().rx.size() <= 40
          && incoming().rx.diff(resource.data.get('rx', {})).affectedKeys().hasOnly([me()])
          && incoming().rx.get(me(), '') in ['', 'like', 'love', 'haha', 'wow', 'sad', 'angry'];
      }
    }

    // ---------- Tea Room ----------
    // teaRooms/{feed}/posts/{pid} (+ /comments/{cid}): feed is 'all' (everyone) or a group id (members only).
    // Only the server writes here (app/api/tea), so anonymous posts never contain who wrote them.
    // teaAuthors, teaLimits, teaReacts, teaReports, teaHidden, teaFlags are server-only (no browser access).
    function teaCanRead(feed) {
      return signedIn() && (feed == 'all' || me() in get(/databases/$(database)/documents/groups/$(feed)).data.members);
    }
    match /teaRooms/{feed}/posts/{pid} {
      allow read: if teaCanRead(feed);
      allow write: if false;
      match /comments/{cid} {
        allow read: if teaCanRead(feed);
        allow write: if false;
      }
    }

    // friend requests: id is "{from}_{to}"
    match /requests/{rid} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && !isBanned()
        && incoming().keys().hasOnly(['from', 'to', 'fromName', 'toName', 'at'])
        && incoming().from == me()
        && incoming().to is string && incoming().to != me()
        && rid == me() + '_' + incoming().to
        && shortText(incoming().fromName, 20) && shortText(incoming().toName, 20)
        // names are the real usernames, so a request can't pretend to come from someone else
        && incoming().fromName == get(/databases/$(database)/documents/users/$(me())).data.username
        && incoming().toName == get(/databases/$(database)/documents/users/$(incoming().to)).data.username
        && !exists(/databases/$(database)/documents/users/$(me())/friends/$(incoming().to));
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow update: if false;
    }

    // online status, "thinking…", last short message, look, and which app/version.
    // Only you, your friends and admins can read it.
    match /presence/{uid} {
      allow read: if signedIn() && (uid == me() || isFriendOf(uid) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && uid == me() && !isBanned()
        && incoming().keys().hasOnly(['online', 'lastSeen', 'username', 'petName', 'skin', 'acc', 'tint', 'makeup', 'status', 'dnd', 'typing', 'typingAt', 'typingTo', 'say', 'client', 'ver', 'np', 'room', 'wseq', 'style'])
        && (!('np' in incoming()) || incoming().np == null || (incoming().np is map && shortText(incoming().np.get('title', ''), 80) && shortText(incoming().np.get('artist', ''), 60)))
        && shortText(incoming().get('room', ''), 40)
        && shortText(incoming().get('status', ''), 40)
        && shortText(incoming().get('petName', ''), 20)
        && shortText(incoming().get('client', ''), 10)
        && shortText(incoming().get('ver', ''), 12)
        && (!('acc' in incoming()) || (incoming().acc is list && incoming().acc.size() <= 12))
        && (!('style' in incoming()) || validStyle(incoming().style))
        && (!('say' in incoming()) || (incoming().say is map && shortText(incoming().say.text, 80) && shortText(incoming().say.id, 40)));
      allow delete: if (signedIn() && uid == me()) || isAdmin();
    }

    // Listen Together rooms: id = the host's uid. Only the host and the friends they invited can
    // see a room. Anyone in it can play / pause / skip / queue; only the host can invite or end it.
    function roomShape() {
      return incoming().keys().hasOnly(['host', 'hostName', 'invited', 'names', 'inv', 'here', 'track', 'playing', 'pos', 'startedAt', 'queue', 'radio', 'repeat', 'shuffle', 'history', 'updatedAt'])
        && incoming().get('inv', {}) is map
        && incoming().get('repeat', 'all') in ['off', 'all', 'one']
        && incoming().get('shuffle', false) is bool
        && incoming().get('history', []) is list && incoming().get('history', []).size() <= 60
        && incoming().invited is list
        // Premium hosts can invite up to 20 friends, everyone else 10
        && (incoming().invited.size() <= 10 || (incoming().invited.size() <= 20 && isPremium(incoming().host)))
        && incoming().get('queue', []) is list && incoming().get('queue', []).size() <= 60
        && shortText(incoming().get('hostName', ''), 20)
        && incoming().get('names', {}) is map && incoming().get('names', {}).size() <= 22
        && incoming().get('here', {}) is map && incoming().get('here', {}).size() <= 22
        && incoming().get('inv', {}).size() <= 22;
    }
    match /rooms/{rid} {
      allow get: if signedIn() && (resource == null || resource.data.host == me() || me() in resource.data.invited);
      // "rooms I'm invited to" (query: invited array-contains me)
      allow list: if signedIn() && me() in resource.data.invited;
      allow create: if signedIn() && !isBanned() && rid == me() && incoming().host == me() && roomShape();
      allow update: if signedIn() && !isBanned() && roomShape() && (
        (resource.data.host == me() && incoming().host == me())
        || (me() in resource.data.invited
          && incoming().host == resource.data.host
          && incoming().invited == resource.data.invited
          && incoming().get('names', {}) == resource.data.get('names', {})
          && incoming().get('inv', {}) == resource.data.get('inv', {})));
      allow delete: if signedIn() && resource.data.host == me();
    }

    // ---------- points (⭐) ----------
    // wallets/{uid}: points, owned shop items, daily bonus, best game scores. Anyone signed in can
    // read (friends' leaderboards); only you can write, and only in these ways:
    //   earn: +1…60 points (≤160 when claiming the daily bonus), ≥ 5 s after the last write, ≤ 1500 a day
    //   spend: owned items grow and points drop by at least 25 per new item
    //   gift out / gift in: matched against a gifts/{id} doc written in the same batch
    //   best: only personal best scores change
    //   total: points earned all-time (the leaderboard); only earning raises it, set once for older wallets
    function today() { return math.floor(request.time.toMillis() / 86400000.0); }
    function wpath(uid) { return /databases/$(database)/documents/wallets/$(uid); }
    function gpath(gid) { return /databases/$(database)/documents/gifts/$(gid); }
    function walletShape() {
      return incoming().keys().hasOnly(['points', 'owned', 'day', 'earned', 'streak', 'daily', 'gin', 'gout', 'best', 'total', 'at'])
        && incoming().get('total', 0) is int && incoming().get('total', 0) >= 0
        && incoming().points is int && incoming().points >= 0
        && incoming().owned is list && incoming().owned.size() <= 200
        && incoming().day is int && incoming().earned is int && incoming().streak is int && incoming().daily is int
        && incoming().gin is string && incoming().gout is string
        && incoming().best is map && incoming().best.size() <= 20
        && incoming().at == request.time;
    }
    function unchanged(keys) { return !incoming().diff(resource.data).affectedKeys().hasAny(keys); }
    function sameTotal() { return incoming().get('total', 0) == resource.data.get('total', 0); }
    function earnOk() {
      let d = incoming().points - resource.data.points;
      let claimDaily = incoming().daily != resource.data.daily;
      return d > 0
        && unchanged(['owned', 'gin', 'gout'])
        && incoming().get('total', 0) == resource.data.get('total', 0) + d
        && request.time > resource.data.at + duration.value(5, 's')
        && incoming().day == today()
        && incoming().earned == (resource.data.day == today() ? resource.data.earned : 0) + d
        && incoming().earned <= 1500
        && (claimDaily
          // Premium doubles the daily bonus (up to 200)
          ? (incoming().daily == today() && resource.data.daily != today() && d <= (isPremium(me()) ? 260 : 160)
             && incoming().streak == (resource.data.daily == today() - 1 ? resource.data.streak + 1 : 1))
          : (d <= 60 && unchanged(['streak'])));
    }
    function spendOk() {
      let n = incoming().owned.size() - resource.data.owned.size();
      return n >= 1 && incoming().owned.hasAll(resource.data.owned)
        && incoming().points <= resource.data.points - 25 * n
        && unchanged(['day', 'earned', 'streak', 'daily', 'gin', 'gout']) && sameTotal();
    }
    function giftOutOk() {
      return incoming().gout != resource.data.gout
        && !exists(gpath(incoming().gout))
        && existsAfter(gpath(incoming().gout))
        && getAfter(gpath(incoming().gout)).data.from == me()
        && incoming().points == resource.data.points - getAfter(gpath(incoming().gout)).data.amount
        && unchanged(['owned', 'day', 'earned', 'streak', 'daily', 'gin']) && sameTotal();
    }
    function giftInOk() {
      return incoming().gin != resource.data.gin
        && get(gpath(incoming().gin)).data.to == me()
        && get(gpath(incoming().gin)).data.claimed == false
        && getAfter(gpath(incoming().gin)).data.claimed == true
        && incoming().points == resource.data.points + get(gpath(incoming().gin)).data.amount
        && unchanged(['owned', 'day', 'earned', 'streak', 'daily', 'gout']) && sameTotal();
    }
    function bestOnly() { return incoming().diff(resource.data).affectedKeys().hasOnly(['best', 'total', 'at']) && sameTotal(); }
    // wallets made before the leaderboard: their total starts at the current balance, once
    function initTotal() {
      return !('total' in resource.data) && incoming().total == resource.data.points
        && incoming().diff(resource.data).affectedKeys().hasOnly(['total', 'at']);
    }
    match /wallets/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == me() && !isBanned() && walletShape()
        && incoming().points == 100 && incoming().owned.size() == 0 && incoming().earned == 0
        && incoming().streak == 0 && incoming().daily == 0 && incoming().gin == '' && incoming().gout == ''
        && incoming().get('total', 0) == 0;
      allow update: if signedIn() && uid == me() && !isBanned() && walletShape()
        && (earnOk() || spendOk() || giftOutOk() || giftInOk() || bestOnly() || initTotal());
      // admins can set points, grant items or reset a wallet
      allow update: if isAdmin() && walletShape();
      allow delete: if isAdmin();
    }
    // a gift of points between friends: the sender's wallet drops by `amount` in the same batch,
    // and the receiver adds it to theirs when they mark it claimed.
    match /gifts/{gid} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && !isBanned()
        && incoming().keys().hasOnly(['from', 'fromName', 'to', 'amount', 'note', 'claimed', 'at'])
        && incoming().from == me() && incoming().to is string && incoming().to != me()
        && isFriendOf(incoming().to)
        && incoming().amount is int && incoming().amount >= 1 && incoming().amount <= 500
        && incoming().claimed == false
        && shortText(incoming().get('note', ''), 60) && shortText(incoming().get('fromName', ''), 20)
        && getAfter(wpath(me())).data.gout == gid;
      allow update: if signedIn() && resource.data.to == me() && resource.data.claimed == false
        && incoming().diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && incoming().claimed == true
        && getAfter(wpath(me())).data.gin == gid;
      allow delete: if signedIn() && resource.data.to == me() && resource.data.claimed == true;
    }

    // live friend games (tic-tac-toe, connect four). Only the two players can see or touch a match;
    // you can only change the board on your own turn.
    function matchShape() {
      return incoming().keys().hasOnly(['game', 'players', 'names', 'board', 'turn', 'status', 'winner', 'moves', 'last', 'at'])
        && incoming().game in ['ttt', 'c4']
        && incoming().players is list && incoming().players.size() == 2
        && incoming().names is map && incoming().names.size() <= 2
        && incoming().board is string && incoming().board.size() <= 64
        && incoming().status in ['invite', 'live', 'done']
        && shortText(incoming().get('turn', ''), 40) && shortText(incoming().get('winner', ''), 40);
    }
    match /matches/{mid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.players || isAdmin());
      allow create: if signedIn() && !isBanned() && matchShape()
        && incoming().players[0] == me() && incoming().players[1] != me()
        && isFriendOf(incoming().players[1]) && incoming().status == 'invite';
      allow update: if signedIn() && !isBanned() && me() in resource.data.players && matchShape()
        && incoming().players == resource.data.players && incoming().game == resource.data.game
        && (resource.data.turn == me() || incoming().board == resource.data.board);
      allow delete: if signedIn() && (me() in resource.data.players || isAdmin());
    }

    // "people on your network": lan/{netId}/members/{uid}. netId is a secret one-way hash of the
    // public IP from /api/netid, so you can only list a network you're on. Only you write your entry.
    match /lan/{net}/members/{uid} {
      allow read: if signedIn() && net.size() >= 8 && net.size() <= 40;
      allow create, update: if signedIn() && uid == me() && !isBanned()
        && net.size() >= 8 && net.size() <= 40
        && incoming().keys().hasOnly(['username', 'petName', 'skin', 'style', 'at'])
        && validName(incoming().username)
        && shortText(incoming().get('petName', ''), 20) && shortText(incoming().get('skin', ''), 20)
        && (!('style' in incoming()) || validStyle(incoming().style))
        && incoming().at == request.time;
      allow delete: if signedIn() && uid == me();
    }

    // sign-up answers: how they found Nibble, country, what for. Written once by the person; admins read.
    match /signup/{uid} {
      allow get: if signedIn() && (uid == me() || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && uid == me()
        && incoming().keys().hasOnly(['source', 'sourceOther', 'country', 'uses', 'at'])
        && shortText(incoming().source, 12) && shortText(incoming().sourceOther, 60)
        && shortText(incoming().country, 2)
        && incoming().uses is list && incoming().uses.size() <= 10
        && incoming().at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // bug reports, feedback and contact-form messages (Hub when signed in, website as an anonymous
    // visitor via /api/feedback; contact messages are also emailed to hello@meetnibble.com).
    // Anyone can send one in this exact shape; only admins can read, mark or delete them.
    match /reports/{id} {
      allow create: if incoming().keys().hasOnly(['kind', 'cat', 'name', 'title', 'what', 'doing', 'expected', 'actual', 'text', 'contact', 'shot', 'ver', 'os', 'client', 'page', 'uid', 'username', 'status', 'at'])
        && incoming().kind in ['bug', 'feedback', 'contact']
        && incoming().cat in ['like', 'dislike', 'feature', 'idea', 'problem', 'general', 'support', 'press', 'partner', '']
        && shortText(incoming().get('name', ''), 60)
        && incoming().status == 'new' && incoming().at == request.time
        && shortText(incoming().title, 80) && shortText(incoming().text, 2000)
        && shortText(incoming().what, 1000) && shortText(incoming().doing, 1000)
        && shortText(incoming().expected, 1000) && shortText(incoming().actual, 1000)
        && shortText(incoming().contact, 100) && shortText(incoming().shot, 700000)
        && (incoming().kind != 'contact' || incoming().contact.matches('^[^@ ]+@[^@ ]+[.][^@ ]{2,}$'))
        && shortText(incoming().ver, 16) && shortText(incoming().os, 40)
        && shortText(incoming().client, 16) && shortText(incoming().page, 80)
        && shortText(incoming().uid, 40) && shortText(incoming().username, 20)
        && (signedIn() ? (incoming().uid == me() && !isBanned()) : (incoming().uid == '' && incoming().username == ''));
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && incoming().diff(resource.data).affectedKeys().hasOnly(['status'])
        && incoming().status in ['new', 'seen', 'done'];
    }

    // shared reminders: rings at `at` for everyone in `people` (the owner + up to 10 friends).
    // Only people on it can see it; the owner can delete it; anyone else can only take themselves off.
    match /reminders/{id} {
      allow read: if signedIn() && me() in resource.data.people;
      allow create: if signedIn() && !isBanned()
        && incoming().keys().hasOnly(['owner', 'ownerName', 'title', 'at', 'people', 'names', 'created'])
        && incoming().owner == me()
        && incoming().people is list && incoming().people.size() >= 1 && incoming().people.size() <= 11
        && incoming().people[0] == me()
        && incoming().names is map && incoming().names.size() <= 11
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 60
        && shortText(incoming().ownerName, 20)
        && incoming().at is int
        && incoming().created == request.time;
      allow update: if signedIn() && me() in resource.data.people && resource.data.owner != me()
        && incoming().diff(resource.data).affectedKeys().hasOnly(['people'])
        && !(me() in incoming().people)
        && resource.data.people.hasAll(incoming().people);
      allow delete: if signedIn() && resource.data.owner == me();
    }

    // direct pokes, waves, cuddles and whispers. Only friends can send; only you can read.
    // Whispers stay up to 30 min so all your devices show the chat; you also keep a copy of each
    // whisper you send in your own inbox (to = the friend, ref = their copy's id).
    match /inbox/{uid}/items/{id} {
      allow read, delete: if signedIn() && uid == me();
      allow create: if signedIn() && !isBanned() && isFriendOf(uid)
        && incoming().keys().hasOnly(['from', 'fromName', 'kind', 'text', 'at', 're'])
        && okReply(incoming())
        && incoming().from == me()
        && incoming().kind is string && incoming().kind.matches('^[a-z]{2,12}$')
        && shortText(incoming().get('text', ''), 80)
        && incoming().at == request.time;
      allow create: if signedIn() && !isBanned() && uid == me()
        && incoming().keys().hasOnly(['from', 'fromName', 'kind', 'text', 'at', 're', 'to', 'ref'])
        && okReply(incoming())
        && incoming().from == me() && incoming().kind == 'whisper'
        && incoming().to is string && exists(/databases/$(database)/documents/users/$(me())/friends/$(incoming().to))
        && incoming().ref is string && incoming().ref.size() <= 40
        && shortText(incoming().get('text', ''), 80)
        && incoming().at == request.time;
      allow update: if false;
    }
  }
}
